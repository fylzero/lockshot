{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lockshot",
  "version": "1.3.3",
  "identifier": "com.lockshot.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lockshot",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNjAxQkVBRjZBMzAwMTMKUldRVEFLUDI2aHRnVVhmNFZTS2d5Tmw2Ull6UHBUcDk0bjNqaGpjYURCMnE5TkYxamlJMmJ1Z0wK",
      "endpoints": [
        "https://github.com/fylzero/lockshot/releases/latest/download/latest.json"
      ]
    }
  }
}
